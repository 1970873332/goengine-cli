{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "incremental": true,
        "allowSyntheticDefaultImports": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowJs": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "preserve",
        "baseUrl": ".",
        "outDir": "dist",
        "composite": true,
        "declaration": true,
        "declarationDir": "dist/types",
        "paths": {
            "@r/vue/*": ["package/vue/src/*"],
            "@r/react/*": ["package/react/src/*"],
            "@r/angular/*": ["package/angular/src/*"],
            "@r/core/*": ["package/core/src/*"],
            "@r/web/*": ["package/web/src/*"],
            "@r/webgl/*": ["package/webgl/src/*"],
            "@r/canvas/*": ["package/canvas/src/*"],
            "@r/service/*": ["package/service/src/*"],
            "@r/electron/*": ["package/electron/src/*"],
            "@r/electrobun/*": ["package/electrobun/src/*"],
            "@/*": ["./*"],
            "static/*": ["public/static/*"]
        },
        "plugins": [
            {
                "name": "typescript-plugin-css-modules"
            }
        ],
        "types": ["node"],
        "typeRoots": ["node_modules/@types"]
    },
    "include": [
        "**/*.js",
        "**/*.ts",
        "**/*.jsx",
        "**/*.tsx",
        "**/*.vue",
        "**/*.json"
    ],
    "exclude": ["dist", "build", "public", "node_modules"]
}
