     declare protected texture: WebGLTexture;
 
+    constructor(gl: Canvas.WebGLContext) {
+        super(gl);
+        // 1x1 白色纹理：图片未加载完成时兜底，避免绑定 undefined
+        this.texture = this.createDefault();
