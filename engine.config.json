{
    "title": "Welcome to GoEngine",
    "tsconfig": {
        "root": "tsconfig.json"
    },
    "application": {
        "name": "GoEngine",
        "version": "0.1.0",
        "id": "com.goengine.app"
    },
    "app": {
        "entry": "Main",
        "config": "preset/Project.ts"
    },
    "static": {
        "favicon": "favicon.ico",
        "public": "public"
    },
    "ssl": {
        "name": "local",
        "output": ".cache/ssl"
    },
    "chii": {
        "port": 3000
    },
    "html": {
        "webpack": {
            "input": "preset/entries/webpack.html",
            "out": "index.html"
        },
        "angular": "index.html",
        "vite": "index.html"
    },
    "web": {
        "out": "dist/web"
    },
    "service": {
        "out": {
            "dir": "dist/service",
            "main": "index.js"
        }
    },
    "electron": {
        "build": "build/electron",
        "input": {
            "main": "preset/entries/electron/Index.ts",
            "preload": "preset/entries/electron/Preload.ts"
        },
        "out": {
            "dir": "dist/electron",
            "main": "index.js",
            "preload": "preload.cjs"
        },
        "dev": {
            "server": {
                "protocol": "http",
                "host": "localhost",
                "port": 8080
            }
        },
        "mirror": "https://npmmirror.com/mirrors/electron/"
    }
}
