{
    "title": "Welcome to GoEngine",
    "tsconfig": {
        "index": "tsconfig.json",
        "angular": ".angular/tsconfig.angular.json"
    },
    "lication": {
        "name": "GoEngine",
        "version": "0.1.0",
        "id": "com.goengine.app"
    },
    "app": {
        "web": "webs",
        "service": "services"
    },
    "ssl": {
        "name": "local",
        "static": ".cache/ssl"
    },
    "release": {
        "compose": "dist/compose"
    },
    "html": {
        "webpack": "preset/entry/webpack.html",
        "angular": "preset/entry/angular.html"
    },
    "web": {
        "build": "build/web"
    },
    "service": {
        "build": "build/service",
        "out": "index.js"
    },
    "tsup": {
        "out": "dist/tsup"
    },
    "electron": {
        "build": "build/electron",
        "input": {
            "main": "preset/entry/electron/Index.ts",
            "preload": "preset/entry/electron/Preload.ts"
        },
        "out": {
            "dir": "dist/electron",
            "main": "index.js",
            "preload": "preload.cjs"
        },
        "dev": {
            "index": {
                "agreement": "http",
                "host": "localhost",
                "port": 8080
            }
        },
        "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "electrobun": {
        "input": "preset/entry/electrobun/Index.ts"
    }
}
