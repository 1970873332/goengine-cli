{
    "title": "Welcome to GoEngine",
    "application": {
        "entry": "Main",
        "config": "preset/Project.ts"
    },
    "webpack": {
        "input": "preset/entries/webpack.html",
        "out": "index.html"
    },
    "static": {
        "favicon": "favicon.ico",
        "public": "public"
    },
    "ssl": {
        "name": "local",
        "output": ".cache/ssl"
    },
    "chii": {
        "port": 3000
    },
    "web": {
        "out": {
            "dir": "dist/web"
        }
    },
    "service": {
        "out": {
            "dir": "dist/service",
            "main": "index.js"
        }
    },
    "electron": {
        "build": "build/electron",
        "input": {
            "main": "preset/entries/electron/Index.ts",
            "preload": "preset/entries/electron/Preload.ts"
        },
        "out": {
            "dir": "dist/electron",
            "main": "index.js",
            "preload": "preload.cjs"
        },
        "mirror": "https://npmmirror.com/mirrors/electron/"
    }
}
