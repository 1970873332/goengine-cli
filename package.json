{
    "name": "@goengine/cli",
    "version": "0.1.0",
    "description": "GoEngine 命令行工具：React / Vue / Angular 项目脚手架与构建 CLI",
    "license": "MIT",
    "author": "Mr.Rui",
    "type": "module",
    "workspaces": [
        "package/*"
    ],
    "bin": {
        "goengine": "dist/cli.js"
    },
    "main": "dist/cli.js",
    "exports": {
        ".": "./dist/cli.js"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=11.0.0"
    },
    "scripts": {
        "build": "tsup --config lib/config/tsup.config.ts",
        "typecheck": "vue-tsc --noEmit",
        "pack:dry": "npm pack --dry-run",
        "clear": "npx --yes rimraf dist assets",
        "install:all": "npx --yes tsx lib/install.ts",
        "clean:modules": "npx --yes tsx lib/clean/modules.ts"
    },
    "dependencies": {
        "@angular-devkit/build-angular": "^21.2.7",
        "@angular/cli": "^21.2.7",
        "@angular/compiler-cli": "^21.2.8",
        "@babel/core": "^7.28.5",
        "@babel/plugin-transform-optional-chaining": "^7.28.5",
        "@babel/plugin-transform-runtime": "^7.28.5",
        "@babel/preset-env": "^7.28.5",
        "@babel/preset-react": "^7.28.5",
        "@babel/runtime": "^7.28.4",
        "@goengine/angular": "workspace:*",
        "@goengine/canvas": "workspace:*",
        "@goengine/core": "workspace:*",
        "@goengine/electron": "workspace:*",
        "@goengine/electrobun": "workspace:*",
        "@goengine/react": "workspace:*",
        "@goengine/service": "workspace:*",
        "@goengine/vue": "workspace:*",
        "@goengine/web": "workspace:*",
        "@goengine/webgl": "workspace:*",
        "@inquirer/prompts": "^8.3.0",
        "@tailwindcss/postcss": "^4.1.17",
        "@tailwindcss/vite": "^4.1.17",
        "@vitejs/plugin-react": "^5.1.1",
        "@vitejs/plugin-vue": "^6.0.2",
        "@vue/compiler-sfc": "^3.5.25",
        "babel-loader": "^10.0.0",
        "chii": "^1.15.5",
        "commander": "^14.0.2",
        "css-loader": "^7.1.2",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "electron-builder": "^26.0.12",
        "esbuild": "^0.27.0",
        "fast-glob": "^3.3.3",
        "html-webpack-plugin": "^5.6.5",
        "mini-css-extract-plugin": "^2.9.4",
        "path-browserify": "^1.0.1",
        "postcss": "^8.5.6",
        "postcss-loader": "^8.2.0",
        "prettier": "^3.7.4",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.9.6",
        "rimraf": "^6.1.2",
        "sass": "^1.97.3",
        "sass-loader": "^16.0.6",
        "selfsigned": "^4.0.0",
        "style-loader": "^4.0.0",
        "tailwindcss": "^4.1.17",
        "terser-webpack-plugin": "^5.3.14",
        "ts-loader": "^9.5.4",
        "ts-shader-loader": "^2.0.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "vite": "^7.2.4",
        "vite-plugin-html": "^3.2.2",
        "vue": "^3.5.25",
        "vue-loader": "^17.4.2",
        "vue-router": "^4.6.3",
        "webpack": "^5.103.0",
        "webpack-bundle-analyzer": "^5.0.1",
        "webpack-dev-server": "^5.2.2",
        "worker-loader": "^3.0.8"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@types/three": "^0.181.0",
        "@types/webpack-bundle-analyzer": "^4.7.0",
        "tsup": "^8.5.1",
        "vue-tsc": "^3.1.8"
    }
}
